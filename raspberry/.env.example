# Copie para .env no Raspberry e ajuste apenas os itens necessários.
CRYSENSE_HOST=0.0.0.0
CRYSENSE_PORT=8080
CRYSENSE_HOME=/opt/crysense

# Hardware: mantenha false durante o desenvolvimento no PC.
CRYSENSE_ENABLE_AUDIO=false
CRYSENSE_ENABLE_CAMERA=true
CRYSENSE_ENABLE_SENSOR=true
CRYSENSE_ENABLE_TFT=true

CRYSENSE_AUDIO_INPUT_DEVICE=
CRYSENSE_AUDIO_OUTPUT_DEVICE=
CRYSENSE_AUDIO_INPUT_CHANNELS=1
CRYSENSE_AUDIO_INPUT_CHANNEL=0
CRYSENSE_AUDIO_OUTPUT_CHANNELS=2
# 0.10 reduz o pico de consumo do MAX98357A; use valores entre 0 e 1.
CRYSENSE_PINK_NOISE_VOLUME=0.10
CRYSENSE_CAMERA_INDEX=0
# Opcional. Em Linux, prefira o caminho estável /dev/v4l/by-id/...-video-index0.
CRYSENSE_CAMERA_DEVICE=
CRYSENSE_CAMERA_WIDTH=640
CRYSENSE_CAMERA_HEIGHT=480
CRYSENSE_CAMERA_FPS=15
# Graus no sentido horário. Use 270 para girar 90° para a esquerda.
CRYSENSE_CAMERA_ROTATION=225

# Modelos gerados por `crysense-train`.
CRYSENSE_TRIGGER_MODEL=models/trigger.joblib
CRYSENSE_TYPE_MODEL=models/type.joblib
CRYSENSE_TRIGGER_THRESHOLD=0.80
CRYSENSE_TYPE_THRESHOLD=0.68
CRYSENSE_TYPE_MARGIN=0.20

# Comunicação local com o serviço de visão que roda no computador.
# Deixe vazio para não exigir token; em feiras, recomenda-se usar uma senha longa.
CRYSENSE_VISION_TOKEN=
CRYSENSE_VISION_STATUS_TIMEOUT=8
