# Copie estas linhas para um arquivo .env.vision no COMPUTADOR que executará o YOLO.
# Não é executado no Raspberry Pi.
CRYSENSE_PI_URL=http://192.168.15.51:8080
CRYSENSE_VISION_TOKEN=

# Para a demonstração sem treino, use o modelo genérico leve. Ele será baixado
# no computador na primeira execução e nunca é enviado ao Raspberry.
CRYSENSE_VISION_MODEL=yolo11n.pt
CRYSENSE_VISION_IMAGE_SIZE=320
CRYSENSE_VISION_CONFIDENCE=0.55
CRYSENSE_VISION_INTERVAL=0.5
CRYSENSE_VISION_REPORT_INTERVAL=0.5
CRYSENSE_VISION_CONSECUTIVE=3

# Sem treino, o YOLO detecta "person" e a regra alerta quando essa pessoa ocupa
# esta zona superior/externa da grade. Formato: x1,y1,x2,y2 (0 a 1).
CRYSENSE_VISION_RISK_LABELS=
CRYSENSE_VISION_RISK_ZONE=
